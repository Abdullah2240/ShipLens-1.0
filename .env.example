# ShipLens environment template.
#
# Copy to .env.local for local development and fill in the blanks:
#   cp .env.example .env.local
# Every value here is a placeholder. Never commit a real password or connection string.
# "Who sets it": you (local machine), Render (dashboard or render.yaml), CI (GitHub Actions).
# A test (scripts/env-example.test.mjs) fails if code reads a variable not listed here.

# --- Application -------------------------------------------------------------

# Postgres connection string. You set it locally (compose.yaml exposes port 5434); Render
# injects it from the managed database. Secret in production.
DATABASE_URL=postgres://shiplens:shiplens@localhost:5434/shiplens

# Public origin used for Origin checks and absolute links. You set it locally; optional on
# Render, where RENDER_EXTERNAL_URL is used instead. Not secret.
APP_ORIGIN=http://localhost:3000

# Public URL of the service. Render sets it automatically; leave it empty locally (an empty
# value also turns keep-warm off). Not secret.
RENDER_EXTERNAL_URL=

# Port the server listens on. The Docker image and Render set it; `npm run dev` uses 3000.
# Not secret.
PORT=3000

# development, test or production. Next.js and the Docker image set it; leave it as is
# locally. Not secret.
NODE_ENV=development

# Log threshold: debug, info, warn or error. You or Render. Not secret.
LOG_LEVEL=info

# Set to 0 to switch off the built-in keep-warm self-ping on Render (it only runs when
# RENDER_EXTERNAL_URL is an https URL). You or Render. Not secret.
KEEP_WARM=1

# --- Seed (demo data) --------------------------------------------------------

# true runs the idempotent seed after migrations (`npm run migrate`). You locally, Render in
# render.yaml. Not secret.
SEED_ON_BOOT=false

# Password for the five demo logins, at least 12 characters. You choose it locally; on Render
# it is entered in the dashboard and shared with judges only through the submission form.
# SECRET: never commit a real value.
SEED_DEMO_PASSWORD=

# true re-hashes the demo logins' passwords to SEED_DEMO_PASSWORD on the next boot; set it for
# one boot only, then remove it. You or Render. Not secret.
SEED_ROTATE_DEMO_PASSWORDS=false

# --- Tests -------------------------------------------------------------------

# Separate database for integration tests; the test setup creates and migrates it. You
# locally, CI in the workflow. Throwaway local credentials, not secret.
TEST_DATABASE_URL=postgres://shiplens:shiplens@localhost:5434/shiplens_test

# Base URL of a running app for the smoke script, the page check and Playwright. You or CI.
# Not secret.
BASE_URL=http://localhost:3000

# Demo password the smoke script logs in with (same value as SEED_DEMO_PASSWORD of the target).
# You or CI (generated per run). SECRET when it points at the live site.
SMOKE_DEMO_PASSWORD=

# Docker compose project name for the end-to-end stack. You or CI. Not secret.
E2E_PROJECT=shiplens-e2e

# Host port of the end-to-end stack. You or CI. Not secret.
E2E_PORT=3100

# Demo password seeded into the throwaway end-to-end stack. You or CI (generated per run).
# Throwaway, but keep it out of git.
E2E_DEMO_PASSWORD=

# Set to 1 to allow end-to-end journeys that need `docker compose exec` into the database
# (the tamper journey); run them from the host only. You. Not secret.
E2E_DB_EXEC=

# Playwright version for the end-to-end runner image; must match package.json. Build
# argument set by the Docker files; override only when upgrading. Not secret.
PLAYWRIGHT_VERSION=1.64.1
